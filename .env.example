# Extraction provider: "mock" (offline, deterministic rule-based) or "openai"
DOCVERIFY_PROVIDER=mock
# Required only when DOCVERIFY_PROVIDER=openai or for `make eval-llm`. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_S=30
OPENAI_MAX_ATTEMPTS=3
# Leave empty to omit temperature (some reasoning models reject it)
OPENAI_TEMPERATURE=0
DOCVERIFY_DB_PATH=var/docverify.db
DOCVERIFY_MAX_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
# Dashboard -> API
API_URL=http://localhost:8100
